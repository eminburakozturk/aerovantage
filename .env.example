# AeroVantage environment configuration
APP_NAME=AeroVantage
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# EPİAŞ transparency platform (TGT auth)
# Canlı için: EPIAS_USERNAME + EPIAS_PASSWORD doldur, EPIAS_USE_MOCK=false
EPIAS_USERNAME=
EPIAS_PASSWORD=
EPIAS_CAS_URL=https://giris.epias.com.tr/cas/v1/tickets
EPIAS_API_KEY=
EPIAS_BASE_URL=https://seffaflik.epias.com.tr/electricity-service/v1
EPIAS_USE_MOCK=true

# Meteoroloji — Open-Meteo için genelde key gerekmez; canlı: WEATHER_USE_MOCK=false
WEATHER_API_KEY=
WEATHER_USE_MOCK=true

# SCADA — URL yoksa SCADA_USE_MOCK=true bırakın
SCADA_API_URL=
SCADA_USE_MOCK=true

# Yapay zeka katmanı (V2)
# Playbook (varsayılan): LLM_PROVIDER=mock
# Canlı LLM (karar asistanı + rapor sor-cevap): LLM_PROVIDER=openai|gemini + LLM_API_KEY, sonra backend restart
# Ayrıntı: docs/AI-ML-OPS.md
LLM_API_KEY=
LLM_PROVIDER=mock

# API güvenliği (Enterprise) — FastAPI Bearer
# Zorunlu. Örnek üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Aynı değeri frontend/.env.local içinde API_SECRET_KEY olarak kullanın.
# Tarayıcıya NEXT_PUBLIC_* olarak koymayın. Varsayılan anahtar YOK.
API_SECRET_KEY=

# Dashboard (yerel geliştirme)
API_URL=http://127.0.0.1:8000/api/v1/pipeline/trigger-pipeline
